{
  "cleanUrls": true,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/session",
      "destination": "/run",
      "permanent": false
    },
    {
      "source": "/combat",
      "destination": "/battle",
      "permanent": false
    }
  ],
  "functions": {
    "api/[area].js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/backup?nightly=1",
      "schedule": "0 9 * * *"
    }
  ]
}
