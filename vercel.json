{
  "cleanUrls": true,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/session",
      "destination": "/run",
      "permanent": false
    },
    {
      "source": "/combat",
      "destination": "/battle",
      "permanent": false
    }
  ],
  "functions": {
    "api/[area].js": {
      "maxDuration": 30
    }
  }
}
